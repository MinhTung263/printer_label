<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.printer.printer_label">
    <queries>
        <package android:name="com.sunmi.printerservice" />
        <package android:name="woyou.aidl.service" />
        <package android:name="net.imin.printer" />
        <package android:name="com.pax.sz.printerservice" />
        <package android:name="com.landicorp.android.pinpadservice" />
        <package android:name="com.urovo.printerservice" />
        <package android:name="android.printservice.urovoprint" />
    </queries>
    <uses-permission android:name="smartpos.deviceservice.permission.Printer" />
    <!-- In LAN: gắn socket vào đúng mạng Wi-Fi chứa máy in (ConnectivityManager) và giữ
         Wi-Fi không ngủ trong lúc in (WifiLock). Đều là quyền thường, không hỏi người dùng. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
</manifest>
